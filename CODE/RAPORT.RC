/*
**	Windows resources of the modern port: the game's icon (as in CC_ICON.RC; SDL also uses
**	it for the window) and version information.
*/

1 ICON "REDALERT.ICO"

1 VERSIONINFO
FILEVERSION		3,3,0,0
PRODUCTVERSION	3,3,0,0
FILEOS			0x40004		/* VOS_NT_WINDOWS32 */
FILETYPE			0x1			/* VFT_APP */
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904B0"
		BEGIN
			VALUE "CompanyName", "Westwood Studios"
			VALUE "FileDescription", "Command & Conquer Red Alert"
			VALUE "FileVersion", "3.03"
			VALUE "InternalName", "redalert"
			VALUE "LegalCopyright", "Copyright 1996 Westwood Studios. Source code released by Electronic Arts under the GPL v3."
			VALUE "OriginalFilename", "redalert.exe"
			VALUE "ProductName", "Command & Conquer Red Alert (modern port)"
			VALUE "ProductVersion", "3.03"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
